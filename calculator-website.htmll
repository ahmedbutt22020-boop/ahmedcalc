<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="A free, fast, simple online calculator by Ahmed Raza.">
<title>Ahmed Raza Calculator | Free Online Calculator</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background: linear-gradient(180deg, #1e1e2f 0%, #15151f 100%);
    color: #fff;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* NAVBAR */
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 40px;
    background: rgba(255,255,255,0.03);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid rgba(255,255,255,0.08);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .logo {
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: 0.5px;
  }
  .logo span { color: #00b894; }
  nav a {
    color: #cfcfe0;
    text-decoration: none;
    margin-left: 28px;
    font-size: 0.95rem;
    transition: color 0.2s;
  }
  nav a:hover { color: #fff; }

  /* HERO */
  .hero {
    text-align: center;
    padding: 50px 20px 20px;
  }
  .hero h1 {
    font-size: 2.2rem;
    margin-bottom: 10px;
  }
  .hero p {
    color: #9a9ab0;
    font-size: 1rem;
    max-width: 500px;
    margin: 0 auto;
  }

  /* MAIN / CALCULATOR */
  main {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 30px 20px;
  }
  .calculator {
    width: 320px;
    background: #2a2a3d;
    border-radius: 20px;
    padding: 20px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.4);
  }
  .credit {
    text-align: center;
    color: #9a9ab0;
    font-size: 0.9rem;
    margin-bottom: 12px;
    letter-spacing: 0.5px;
  }
  .display {
    background: #16161f;
    color: #fff;
    border-radius: 12px;
    padding: 24px 16px;
    text-align: right;
    font-size: 2.4rem;
    margin-bottom: 16px;
    min-height: 70px;
    overflow-x: auto;
    word-break: break-all;
  }
  .buttons {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
  }
  button {
    border: none;
    border-radius: 12px;
    font-size: 1.2rem;
    padding: 18px 0;
    cursor: pointer;
    background: #3a3a52;
    color: #fff;
    transition: filter 0.1s;
  }
  button:hover { filter: brightness(1.2); }
  button:active { filter: brightness(0.9); }
  .operator { background: #ff9500; }
  .equals { background: #00b894; grid-column: span 2; }
  .clear, .delete { background: #6c6c80; }
  .zero { grid-column: span 2; }

  /* FEATURES */
  .features {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
    padding: 20px 20px 60px;
  }
  .feature-card {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 14px;
    padding: 20px;
    width: 220px;
    text-align: center;
  }
  .feature-card h3 {
    font-size: 1rem;
    margin-bottom: 8px;
    color: #00b894;
  }
  .feature-card p {
    font-size: 0.85rem;
    color: #9a9ab0;
  }

  /* FOOTER */
  footer {
    text-align: center;
    padding: 24px;
    color: #6c6c80;
    font-size: 0.85rem;
    border-top: 1px solid rgba(255,255,255,0.08);
  }
  footer a {
    color: #00b894;
    text-decoration: none;
  }

  @media (max-width: 600px) {
    header { padding: 16px 20px; }
    nav a { margin-left: 16px; font-size: 0.85rem; }
    .hero h1 { font-size: 1.6rem; }
  }
</style>
</head>
<body>

<header>
  <div class="logo">Ahmed<span>Calc</span></div>
  <nav>
    <a href="#calculator">Calculator</a>
    <a href="#features">Features</a>
    <a href="#about">About</a>
  </nav>
</header>

<section class="hero">
  <h1>Fast, Free Online Calculator</h1>
  <p>A clean, simple calculator that works right in your browser — no downloads, no sign-ups.</p>
</section>

<main id="calculator">
  <div class="calculator">
    <div class="credit">made by Ahmed Raza</div>
    <div class="display" id="display">0</div>
    <div class="buttons">
      <button class="clear" onclick="clearAll()">AC</button>
      <button class="delete" onclick="deleteLast()">DEL</button>
      <button class="operator" onclick="appendValue('%')">%</button>
      <button class="operator" onclick="appendValue('/')">÷</button>

      <button onclick="appendValue('7')">7</button>
      <button onclick="appendValue('8')">8</button>
      <button onclick="appendValue('9')">9</button>
      <button class="operator" onclick="appendValue('*')">×</button>

      <button onclick="appendValue('4')">4</button>
      <button onclick="appendValue('5')">5</button>
      <button onclick="appendValue('6')">6</button>
      <button class="operator" onclick="appendValue('-')">−</button>

      <button onclick="appendValue('1')">1</button>
      <button onclick="appendValue('2')">2</button>
      <button onclick="appendValue('3')">3</button>
      <button class="operator" onclick="appendValue('+')">+</button>

      <button class="zero" onclick="appendValue('0')">0</button>
      <button onclick="appendValue('.')">.</button>
      <button class="equals" onclick="calculate()">=</button>
    </div>
  </div>
</main>

<section class="features" id="features">
  <div class="feature-card">
    <h3>⚡ Fast</h3>
    <p>Instant calculations with zero lag, right in your browser.</p>
  </div>
  <div class="feature-card">
    <h3>⌨️ Keyboard Ready</h3>
    <p>Use your keyboard for numbers, operators, Enter, and Backspace.</p>
  </div>
  <div class="feature-card">
    <h3>📱 Responsive</h3>
    <p>Works smoothly on desktop, tablet, and mobile screens.</p>
  </div>
</section>

<footer id="about">
  <p>Made with ❤️ by <a href="#">Ahmed Raza</a> &middot; © 2026 AhmedCalc. All rights reserved.</p>
</footer>

<script>
  let expression = '';
  const display = document.getElementById('display');

  function updateDisplay() {
    display.textContent = expression === '' ? '0' : expression;
  }

  function appendValue(val) {
    const lastChar = expression.slice(-1);
    const operators = ['+', '-', '*', '/', '%'];
    if (operators.includes(val) && operators.includes(lastChar)) {
      expression = expression.slice(0, -1) + val;
    } else {
      expression += val;
    }
    updateDisplay();
  }

  function clearAll() {
    expression = '';
    updateDisplay();
  }

  function deleteLast() {
    expression = expression.slice(0, -1);
    updateDisplay();
  }

  function calculate() {
    try {
      if (!/^[0-9+\-*/.%\s]+$/.test(expression)) {
        throw new Error('Invalid input');
      }
      let result = Function('"use strict"; return (' + expression.replace(/%/g, '/100') + ')')();
      if (result === undefined || isNaN(result) || !isFinite(result)) {
        throw new Error('Math error');
      }
      expression = String(result);
      updateDisplay();
    } catch (e) {
      display.textContent = 'Error';
      expression = '';
    }
  }

  document.addEventListener('keydown', (e) => {
    if (/[0-9.+\-*/%]/.test(e.key)) {
      appendValue(e.key);
    } else if (e.key === 'Enter' || e.key === '=') {
      e.preventDefault();
      calculate();
    } else if (e.key === 'Backspace') {
      deleteLast();
    } else if (e.key === 'Escape') {
      clearAll();
    }
  });
</script>

</body>
</html>
